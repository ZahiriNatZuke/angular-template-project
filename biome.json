{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!dist",
			"!node_modules",
			"!**/package.json",
			"!**/pnpm-lock.yaml"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"bracketSpacing": true,
		"lineEnding": "lf"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useImportType": "off",
				"noNonNullAssertion": {
					"level": "info"
				}
			},
			"suspicious": {
				"noExplicitAny": {
					"level": "info"
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"enabled": true,
			"quoteStyle": "single",
			"lineEnding": "lf",
			"bracketSpacing": true,
			"indentWidth": 2,
			"quoteProperties": "asNeeded",
			"trailingCommas": "es5",
			"semicolons": "always",
			"indentStyle": "tab",
			"arrowParentheses": "asNeeded"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"json": {
		"parser": {
			"allowComments": true
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 2,
			"lineEnding": "lf"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"lineEnding": "lf",
			"indentStyle": "tab",
			"indentWidth": 2,
			"quoteStyle": "single"
		}
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.html"],
			"linter": {
				"rules": {
					"a11y": {
						"useValidAnchor": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/core/utils/router-seo.init.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"useLiteralKeys": "off"
					}
				}
			}
		}
	]
}
