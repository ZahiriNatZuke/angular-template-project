{
  "name": "angular-template-project",
  "version": "1.0.0",
  "description": "Modern Angular 21 template with zoneless change detection, NgRx SignalStore, ultra-secure HttpOnly cookie authentication, TailwindCSS v4, and i18n support. Production-ready with best practices for security, performance, and scalability.",
  "keywords": [
    "angular",
    "angular-21",
    "template",
    "standalone-components",
    "zoneless",
    "ngrx-signalstore",
    "tailwindcss",
    "daisyui",
    "authentication",
    "httponly-cookies",
    "csrf-protection",
    "i18n",
    "seo",
    "vitest",
    "biome",
    "pnpm"
  ],
  "author": {
    "name": "Yohan González Almaguer",
    "email": "yohan.gonzalez.almaguer@gmail.com",
    "url": "https://github.com/ZahiriNatZuke"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZahiriNatZuke/angular-template-project.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "format": "biome format --fix",
    "lint": "biome check --fix --unsafe",
    "precommit": "npm run lint && npm run format",
    "prepare": "husky"
  },
  "private": false,
  "license": "MIT",
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.6",
    "@angular/compiler": "^21.0.6",
    "@angular/core": "^21.0.6",
    "@angular/forms": "^21.0.6",
    "@angular/platform-browser": "^21.0.6",
    "@angular/router": "^21.0.6",
    "@ng-web-apis/common": "^5.0.1",
    "@ngrx/operators": "^21.0.0",
    "@ngrx/signals": "^21.0.0",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@vercel/speed-insights": "^1.3.1",
    "lodash-es": "^4.17.22",
    "lucide": "^0.562.0",
    "lucide-angular": "^0.562.0",
    "notiflix": "^3.2.8",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.0",
    "@analogjs/vitest-angular": "^2.2.0",
    "@angular-devkit/build-angular": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.6",
    "@biomejs/biome": "^2.3.10",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.4",
    "@vitest/ui": "^4.0.16",
    "daisyui": "^5.5.14",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.19.0",
    "pnpm": ">=8.0.0"
  }
}
