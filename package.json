{
  "name": "angular-template-project",
  "version": "2.0.0",
  "description": "Modern Angular 22 template with zoneless change detection, NgRx SignalStore, ultra-secure HttpOnly cookie authentication, TailwindCSS v4, and i18n support. Production-ready with best practices for security, performance, and scalability.",
  "keywords": [
    "angular",
    "angular-22",
    "template",
    "standalone-components",
    "zoneless",
    "ngrx-signalstore",
    "tailwindcss",
    "daisyui",
    "authentication",
    "httponly-cookies",
    "csrf-protection",
    "i18n",
    "seo",
    "vitest",
    "biome",
    "pnpm"
  ],
  "author": {
    "name": "Yohan González Almaguer",
    "email": "yohan.gonzalez.almaguer@gmail.com",
    "url": "https://github.com/ZahiriNatZuke"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZahiriNatZuke/angular-template-project.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "format": "biome format --fix",
    "lint": "biome check --fix --unsafe",
    "lint:ci": "biome ci",
    "precommit": "npm run lint && npm run format",
    "prepare": "husky"
  },
  "private": false,
  "license": "MIT",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@lucide/angular": "^1.27.0",
    "@ng-web-apis/common": "^5.3.0",
    "@ngrx/operators": "^21.1.1",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/speed-insights": "^2.0.0",
    "lodash-es": "^4.18.1",
    "lucide": "^1.27.0",
    "notiflix": "^3.2.8",
    "postcss": "^8.5.23",
    "rxjs": "~7.8.2",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@biomejs/biome": "^2.5.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "daisyui": "^5.7.4",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=8.0.0"
  }
}
